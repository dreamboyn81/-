<?xml version="1.0" encoding="utf-8"?>
<!-- Settings. Deliberately a subset of the desktop page: the storage-path and
     game-library-folder pickers are omitted because Android has no scanned library
     (games arrive one .xap at a time through the document picker) and the data path
     is fixed to the app-private external files dir. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wp_background"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/wp_page_margin"
      android:paddingEnd="@dimen/wp_page_margin"
      android:paddingTop="28dp"
      android:paddingBottom="36dp">

    <TextView
        android:id="@+id/appTitle"
        style="@style/WpAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title" />

    <TextView
        android:id="@+id/pageTitle"
        style="@style/WpPageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="26dp"
        android:text="设置" />

    <TextView
        style="@style/WpSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="玩家代号" />

    <EditText
        android:id="@+id/gamerTagInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/wp_chrome"
        android:padding="12dp"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/wp_foreground"
        android:textColorHint="@color/wp_disabled"
        android:textSize="18sp"
        android:fontFamily="sans-serif"
        android:hint="玩家" />

    <TextView
        style="@style/WpSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="强调色" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/wp_subtle"
        android:textSize="13sp"
        android:text="立即应用到界面。" />

    <GridLayout
        android:id="@+id/accentGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="5" />

    <TextView
        style="@style/WpSectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="存储" />

    <TextView
        android:id="@+id/storagePathText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/wp_subtle"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/storageNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/wp_subtle"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:text="你所安装的游戏和数据都存放在这里。" />

  </LinearLayout>
</ScrollView>
